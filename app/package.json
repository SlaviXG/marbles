{
  "name": "marbles",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Live visualization of the Obsidian vault (force-directed graph).",
  "scripts": {
    "setup:wake": "node scripts/setup-wake.mjs",
    "predev": "npm run setup:wake",
    "preclient": "npm run setup:wake",
    "prebuild": "npm run setup:wake",
    "dev": "concurrently -k -n server,client -c blue,green \"node server/index.mjs\" \"vite\"",
    "server": "node server/index.mjs",
    "client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^0.10.14",
    "chokidar": "^3.6.0",
    "d3-force-3d": "^3.0.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.25.5",
    "ws": "^8.18.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
