# Repository parameters (template).
#
# Copy this file to `.env` and fill in the values for THIS machine.
# `.env` is gitignored, so machine-specific paths stay local and never get
# committed, so each computer/clone keeps its own.
#
# Agents: read `.env` at the start of work to resolve these parameters.

# Absolute path to the Obsidian notes vault for this project. Agents read it for
# context (notes are authored/edited in Obsidian). Differs per machine.
# Example (Windows): C:\Users\you\Notes\MyVault
# Example (macOS/Linux): /home/user/Notes/MyVault
OBSIDIAN_VAULT_DIR=

# OpenAI API key (secret). Set the real value only in `.env`, never here.
OPENAI_API_KEY=

# ElevenLabs spoken replies. Without this key, replies use OpenAI fallback.
# Keys are re-read when this file changes, and linked git worktrees fall back
# to the main checkout's .env, so no restart or copy is needed.
ELEVENLABS_API_KEY=
# Optional ElevenLabs voice and model overrides.
# ELEVENLABS_VOICE_ID=DODLEQrClDo8wCz460ld
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Hermes coordinator with Claude (planning and delegation after recognition).
# Put the real key only in .env.
ANTHROPIC_API_KEY=
# Optional overrides for the coordinator. The default model is claude-opus-5-5
# with adaptive thinking at medium effort; claude-sonnet-5-5 or effort low is faster.
# MARBLES_COORDINATOR_MODEL=claude-opus-5-5
# MARBLES_COORDINATOR_EFFORT=medium

# Confirmed emails try Claude's Gmail connector, then Codex's, then the Mac's
# Mail app. "mail" goes straight to Mail.
# MARBLES_EMAIL_VIA=agent
# Your own address, for "mail me ...". Defaults to git's user.email.
# MARBLES_USER_EMAIL=you@example.com
# "off" stops ordinary delegated tasks from using the Gmail connector.
# MARBLES_AGENT_GMAIL=on
# Worker file access: workspace (default) or full. Full lets Codex and Claude
# work anywhere this macOS account may write, without headless permission prompts.
# MARBLES_AGENT_ACCESS=workspace
# The small model that reads screenshots when Hermes needs to look.
# MARBLES_VISION_MODEL=claude-haiku-5-5
